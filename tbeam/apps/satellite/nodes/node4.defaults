# Per-unit provisioning overlay (ADR 0016 slot = node_id). Build with
#   idf.py -B build-node4 -DSDKCONFIG=build-node4/sdkconfig \
#          -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;nodes/node4.defaults" -DIDF_TARGET=<esp32|esp32s3> build
# (ESP-IDF applies sdkconfig.defaults.<target> after each listed file.)
CONFIG_SWARM_NODE_ID=4
