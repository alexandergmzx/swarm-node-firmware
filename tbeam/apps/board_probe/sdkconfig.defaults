CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Console and flash size are per target: sdkconfig.defaults.esp32 (classic,
# UART0 through the CH9102 bridge, 4 MB) and sdkconfig.defaults.esp32s3 (S3
# Supreme, native USB-Serial-JTAG, 8 MB). ESP-IDF applies <file>.<target>
# right after each listed defaults file.
